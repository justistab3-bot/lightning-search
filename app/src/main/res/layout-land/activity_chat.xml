<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_close" android:src="@drawable/ic_arrow_back" app:tint="@color/ink_body" android:minHeight="48dp" />
        <TextView android:id="@+id/headerTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:text="@string/chat_title" android:textAppearance="@style/TextAppearance.FlashSearch.Section" android:maxLines="1" android:ellipsize="end" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clearButton" style="@style/Widget.FlashSearch.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:text="@string/chat_clear" android:minHeight="48dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line_subtle" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/messageList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" />
        <ScrollView android:id="@+id/emptyBox" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/page_gutter" android:paddingTop="56dp" android:paddingEnd="@dimen/page_gutter" android:paddingBottom="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_greeting" android:textAppearance="@style/TextAppearance.FlashSearch.Title" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/chat_greeting_hint" android:textAppearance="@style/TextAppearance.FlashSearch.Caption" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/suggestionGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:chipSpacingVertical="10dp" app:singleLine="false" />
            </LinearLayout>
        </ScrollView>
        <ProgressBar android:id="@+id/connecting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/switchGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:chipSpacingHorizontal="8dp" app:singleLine="false">
            <com.google.android.material.chip.Chip android:id="@+id/thinkChip" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_think" />
            <com.google.android.material.chip.Chip android:id="@+id/searchChip" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_search" />
        </com.google.android.material.chip.ChipGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <ImageButton android:id="@+id/imageButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/chat_pick_image" android:padding="11dp" android:src="@drawable/ic_image" android:minHeight="48dp" />
            <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input" android:gravity="center_vertical" android:hint="@string/chat_hint" android:inputType="textMultiLine|textCapSentences" android:maxLines="1" android:minHeight="48dp" android:paddingStart="14dp" android:paddingTop="11dp" android:paddingEnd="14dp" android:paddingBottom="11dp" android:textColor="@color/ink" android:textColorHint="@color/ink_tertiary" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sendButton" style="@style/Widget.FlashSearch.PrimaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="10dp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingTop="0dp" android:paddingEnd="12dp" android:paddingBottom="0dp" android:text="@string/chat_send" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
