<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏 · 整页结果页。

  **这一份是新增的** —— 之前整页结果页根本没有横屏版，横屏下用的是竖屏那份：
  标题栏 56dp + 原图 180dp = 236dp，而词典笔屏幕只有 254dp 高，
  答案区只剩十几 dp，等于看不到答案。

  这里把原图挪到**左侧独立一栏**，右侧纵向排「题块 → 候选答案 → 底栏」。
  横屏宽度足够摆两栏，纵向就腾出来了。两种横屏高度下都成立，所以不需要再分版本。

  ID 与类型必须和 layout/activity_page_result.xml 一致（ViewBinding 只按其中一份
  生成字段类型）。LayoutSanityTest 检查 id 集合与视图类型两条规则。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/charcoal_warm" />

        <com.heikeji.phonesearch.ui.common.SubjectIconView
            android:id="@+id/subjectBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/page_title"
            android:textAppearance="@style/TextAppearance.FlashSearch.Serif.Section" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <!-- 左：整页原图（点开框选） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/photoCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/ivory"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_cream"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/pagePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/page_original_photo"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/photoHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle_scrim"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/page_tap_to_select"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 右：题块 -> 候选答案 -> 底栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1.7"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/blockScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/blockRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:tabIndicatorHeight="0dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="2dp"
                app:tabPaddingStart="2dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxLines="3"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAppearance="@style/TextAppearance.FlashSearch.Body"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.FlashSearch.Caption"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cropButton"
                    style="@style/Widget.FlashSearch.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/action_crop_research"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/terracotta"
        android:visibility="gone" />
</LinearLayout>
