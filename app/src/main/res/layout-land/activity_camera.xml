<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏：控件收紧，快门与切换放到底部条两侧，尽量少占画面 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />
    </FrameLayout>

    <View
        android:id="@+id/framingHint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/closeButton"
            style="@style/Widget.FlashSearch.CircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/camera_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/flipButton"
            style="@style/Widget.FlashSearch.CircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/camera_flip"
            android:src="@drawable/ic_flip" />

        <ImageButton
            android:id="@+id/flashButton"
            style="@style/Widget.FlashSearch.CircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/camera_flash"
            android:src="@drawable/ic_flash_auto" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/shutterButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="72dp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="@string/camera_shutter" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>