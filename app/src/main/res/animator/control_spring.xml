<?xml version="1.0" encoding="utf-8"?>
<!-- State animation keeps click, long press, keyboard and ripple handling native. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="0" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="0" />
        </set>
    </item>
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" android:duration="60" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" android:duration="60" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="240" android:interpolator="@interpolator/motion_spring" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="240" android:interpolator="@interpolator/motion_spring" />
        </set>
    </item>
</selector>
