<?xml version="1.0" encoding="utf-8"?>
<!--
  「墨蓝学院」设计语言（v1.36.0 全量重构）：

  - 冷雾蓝灰页面底 + 纯白卡片，层次靠「浅投影 + 冷描边」双保险
  - 靛蓝是唯一品牌高信号色（与应用图标的蓝紫底 #3B2FA5 同族）
  - 全套无衬线：标题加粗、正文常规，不再使用衬线标题
  - 学科色鲜明但不过曝，徽标上压白线稿

  对比度底线：ink_tertiary 在白卡上 ≥4.5:1，brand 上压白字 ≥4.5:1。
-->
<resources>
    <color name="on_subject">#FFFFFF</color>
    <!-- 品牌：靛蓝 -->
    <color name="brand">#3B4DB8</color>
    <color name="brand_pressed">#2E3D99</color>
    <!-- brand 上的文字/图标：亮色下是白，暗色下 brand 提亮成浅靛，压深墨才可读 -->
    <color name="on_brand">#FFFFFF</color>
    <color name="brand_container">#E4E9FC</color>
    <color name="on_brand_container">#1F2A6E</color>
    <color name="link">#2E6BE6</color>
    <color name="star_amber">#FFB020</color>

    <!-- 语义色 -->
    <color name="danger">#CC3333</color>
    <color name="warning">#B26A00</color>
    <color name="success">#1E7F4E</color>

    <!-- 表面 -->
    <color name="bg">#EEF1F8</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#F6F8FD</color>
    <color name="surface_sunken">#E3E8F4</color>

    <!-- 相机（沉浸深色，带一点蓝调） -->
    <color name="cam_dark">#0D1020</color>
    <color name="cam_panel">#161B30</color>
    <color name="scrim">#66000000</color>

    <!-- 文字 -->
    <color name="ink">#171B2B</color>
    <color name="ink_body">#3A4258</color>
    <color name="ink_secondary">#5D6683</color>
    <color name="ink_tertiary">#6E7896</color>

    <!-- 描边 -->
    <color name="line">#D8DEF0</color>
    <color name="line_subtle">#E6EAF6</color>
    <color name="line_strong">#B9C3E0</color>

    <!-- 通用 -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 学科标识色：鲜明、白线稿可读 -->
    <color name="subject_math">#D9502A</color>
    <color name="subject_chinese">#1F9A62</color>
    <color name="subject_english">#2E77D0</color>
    <color name="subject_physics">#7A52C8</color>
    <color name="subject_chemistry">#0E9A94</color>
    <color name="subject_biology">#5B9E24</color>
    <color name="subject_history">#C07E12</color>
    <color name="subject_geography">#2E8FB8</color>
    <color name="subject_politics">#CE4771</color>
    <color name="subject_default">#6E7896</color>
</resources>
