<?xml version="1.0" encoding="utf-8"?>
<!--
  暖色调中性色 + 陶土色品牌（参考 Claude 设计系统）。
  刻意不使用冷灰、不使用渐变：层次靠暖色表面差与环形描边建立。
-->
<resources>
    <!--
      品牌陶土色。
      原来是 #C96442 —— 象牙白文字压在上面只有 3.70:1，低于正文所需的 4.5:1。
      压暗到 #B0583A 后是 4.63:1 ✅（按下态再深一档保持层次）。
      视觉上几乎看不出差别，但这套设计里唯一的饱和色本来就该扛得住白字。
    -->
    <color name="terracotta">#B0583A</color>
    <color name="terracotta_pressed">#9E4F34</color>
    <color name="coral">#D97757</color>
    <color name="error_crimson">#B53333</color>
    <color name="focus_blue">#3898EC</color>

    <!-- 表面 -->
    <color name="parchment">#F5F4ED</color>
    <color name="ivory">#FAF9F5</color>
    <color name="pure_white">#FFFFFF</color>
    <color name="warm_sand">#E8E6DC</color>
    <color name="dark_surface">#30302E</color>
    <color name="deep_dark">#141413</color>

    <!-- 文字 -->
    <color name="near_black">#141413</color>
    <color name="charcoal_warm">#4D4C48</color>
    <color name="olive_gray">#5E5D59</color>
    <!--
      次要文字色。Caption 与 Label 都用它，也就是提示语、日期、统计标签、
      时间戳全靠这一个值。
      原来是 #87867F：羊皮纸上 3.31:1、卡片上 3.47:1，都低于 4.5:1。
      压暗到 #71706A 后是 4.50 / 4.71 ✅ —— 这是全项目影响面最大的一处修正。
    -->
    <color name="stone_gray">#71706A</color>
    <color name="dark_warm">#3D3D3A</color>
    <color name="warm_silver">#B0AEA5</color>

    <!--
      描边 / 环形。
      border_cream 原来是 #F0EEE6 —— 在羊皮纸上 1.05:1、在卡片上 1.10:1，
      等于没有。配合「象牙白卡片 on 羊皮纸 1.05:1」就是：卡片和背景同色，
      唯一的边界又看不见。在词典笔那种 mdpi 廉价屏上完全消失。
      收到 #D8D6CF（1.32 / 1.38）—— 好屏幕上依然是克制的柔边，矮屏上能看见了。
      再深就会破坏整套柔和感，这是个刻意的折中，不是往 3:1 靠。
    -->
    <color name="border_cream">#D8D6CF</color>
    <color name="border_warm">#E8E6DC</color>
    <color name="border_dark">#30302E</color>
    <color name="ring_warm">#D1CFC5</color>
    <color name="ring_deep">#C2C0B6</color>

    <!-- 相机（沉浸深色） -->
    <color name="camera_scrim">#66000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 学科标识色（低饱和、偏土质，与整体色调一致） -->
    <color name="subject_math">#C96442</color>
    <color name="subject_chinese">#6B7A4F</color>
    <color name="subject_english">#5B6B7C</color>
    <color name="subject_physics">#7A5C8E</color>
    <color name="subject_chemistry">#4F7A6B</color>
    <color name="subject_biology">#6B8E4F</color>
    <color name="subject_history">#9A6B3F</color>
    <color name="subject_geography">#5F7A8E</color>
    <color name="subject_politics">#8E5C5C</color>
    <color name="subject_default">#87867F</color>
</resources>
