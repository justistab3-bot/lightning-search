<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <!-- Natural height provides scrolling on short screens; weights fill taller screens. -->
        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/home_header_min_height">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FlashSearch.HomeGreeting" />
                    <TextView
                        android:id="@+id/tagline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.FlashSearch.HomeTagline"
                        android:textColor="@color/ink_secondary" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    style="@style/Widget.FlashSearch.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_title" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/homeMain"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:baselineAligned="false">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/line"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/modeGroup"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:selectionRequired="true"
                                app:singleSelection="true">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/modeSingle"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minHeight="48dp"
                                    android:minWidth="0dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:text="@string/mode_single" />
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/modePage"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minHeight="48dp"
                                    android:minWidth="0dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:text="@string/mode_page" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/takePhotoButton"
                                style="@style/Widget.FlashSearch.PrimaryButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:layout_marginStart="8dp"
                                android:minHeight="@dimen/home_capture_height"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/action_take_photo"
                                android:textSize="16sp"
                                android:textColor="@color/on_brand_container"
                                android:gravity="center"
                                android:elevation="0dp"
                                android:stateListAnimator="@animator/control_spring"
                                app:backgroundTint="@color/brand_container"
                                app:icon="@drawable/ic_camera"
                                app:iconTint="@color/brand"
                                app:iconSize="26dp"
                                app:iconGravity="textStart"
                                app:iconPadding="10dp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/modeHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.FlashSearch.Caption"
                            android:paddingTop="8dp"
                            android:maxLines="2"
                            android:text="@string/mode_hint_single"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:id="@+id/homeTools"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/essayButton"
                        style="@style/Widget.FlashSearch.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/home_tool_height"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/essay_entry" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chatButton"
                        style="@style/Widget.FlashSearch.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="@dimen/home_tool_height"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/chat_entry" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/homeFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:id="@+id/historySection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/historyToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.FlashSearch.Section"
                            android:text="@string/history_title" />
                        <ImageView
                            android:id="@+id/historyChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink_secondary" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/versionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:maxWidth="120dp"
                    android:layout_marginStart="12dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.FlashSearch.Label" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
