<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 预览放在容器里：PreviewView 会被撑成正方形并按设定角度旋转，
         正方形边长取屏幕长边，因此旋转任意 90 度倍数都能铺满可视区域。 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />
    </FrameLayout>

    <View
        android:id="@+id/framingHint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_framing_hint" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="150dp"
        android:background="@drawable/bg_circle_scrim"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/camera_hint"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/closeButton"
            style="@style/Widget.FlashSearch.CircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/flipButton"
            style="@style/Widget.FlashSearch.CircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/camera_flip"
            android:src="@drawable/ic_flip" />

        <ImageButton
            android:id="@+id/flashButton"
            style="@style/Widget.FlashSearch.CircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/camera_flash"
            android:src="@drawable/ic_flash_auto" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/shutterButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shutter"
            android:contentDescription="@string/camera_shutter" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>