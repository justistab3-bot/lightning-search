<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SearchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlashSearch"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <!--
          相机不锁方向：方向交给 CameraX 的 targetRotation。
          configChanges 让旋转时不重建 Activity，避免相机反复重绑。
        -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.crop.CropActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 整页搜题：题块列表 + 候选答案 -->
        <activity
            android:name=".ui.page.PageResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 框选一道题：缩放平移 + 拖动框角 -->
        <activity
            android:name=".ui.page.SelectImageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.verification.VerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
