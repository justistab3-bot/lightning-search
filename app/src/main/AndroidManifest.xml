<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 应用内更新下载完成后调系统安装器；Android 8+ 还需用户在设置里单独授权 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      友盟 SDK 的清单会自动带上这两个权限，本应用用不到，显式移除：
      - AD_ID 是广告标识符，搜题工具没有任何广告场景，留着既无意义
        又会让应用商店和用户起疑。
      - 只保留友盟自己的设备标识（UMID）就足够统计日活与崩溃去重。
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      包可见性（Android 11+）：官方设备保护 SDK（dpsdk）会以官方包名
      getPackageInfo 读取签名，不声明 <queries> 会抛 NameNotFoundException，
      原生层未处理该异常会直接 JNI abort（定位过 tombstone）。
      闪电搜题为快对作业官方运营的精简版客户端（研发部已确认）。
    -->
    <queries>
        <package android:name="com.kuaiduizuoye.scan" />
    </queries>

    <application
        android:name=".SearchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlashSearch"
        android:usesCleartextTraffic="false">

        <!--
          启动入口是首页，不是登录页。
          登录已经改成可选项（实测搜题不需要账号），入口在首页的设置里。
          之前这里是 LoginActivity 当 LAUNCHER，导致新装设备点图标直接进登录页，
          连首次引导都走不到 —— 匿名模式等于没生效。
        -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          AI 作文：不锁方向，横竖屏各有一套布局。
          旋转时 Activity 重建，状态由 ViewModel 保留。
        -->
        <activity
            android:name=".ui.essay.EssayActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 首次启动引导：选年级 + 账号说明（登录已改为可选） -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.privacy.PrivacyActivity"
            android:exported="false" />

        <!-- 快问 AI：流式对话，键盘顶起输入区 -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          相机不锁方向：方向交给 CameraX 的 targetRotation。
          configChanges 让旋转时不重建 Activity，避免相机反复重绑。
        -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.crop.CropActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 整页搜题：题块列表 + 候选答案 -->
        <activity
            android:name=".ui.page.PageResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 框选一道题：缩放平移 + 拖动框角 -->
        <activity
            android:name=".ui.page.SelectImageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.verification.VerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 断网全屏提示：不留在最近任务里，网络恢复后自行关闭 -->
        <activity
            android:name=".ui.offline.NoNetworkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <!-- 应用内更新：查看说明 -> 直链下载 -> 调系统安装器 -->
        <activity
            android:name=".update.UpdateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          长按拍照搜题时，把目标文件交给系统相机写入。
          只暴露 cache/captures/，exported=false，且只授予单次 URI 权限。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
