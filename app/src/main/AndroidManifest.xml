<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 应用内更新下载完成后调系统安装器；Android 8+ 还需用户在设置里单独授权 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SearchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlashSearch"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <!--
          AI 作文：不锁方向，横竖屏各有一套布局。
          旋转时 Activity 重建，状态由 ViewModel 保留。
        -->
        <activity
            android:name=".ui.essay.EssayActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          相机不锁方向：方向交给 CameraX 的 targetRotation。
          configChanges 让旋转时不重建 Activity，避免相机反复重绑。
        -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.crop.CropActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 整页搜题：题块列表 + 候选答案 -->
        <activity
            android:name=".ui.page.PageResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 查看整本答案：教辅答案扫描图，左右翻页 -->
        <activity
            android:name=".ui.book.BookAnswerActivity"
            android:exported="false" />

        <!-- 框选一道题：缩放平移 + 拖动框角 -->
        <activity
            android:name=".ui.page.SelectImageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FlashSearch.Camera" />

        <activity
            android:name=".ui.verification.VerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 断网全屏提示：不留在最近任务里，网络恢复后自行关闭 -->
        <activity
            android:name=".ui.offline.NoNetworkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <!-- 应用内更新：查看说明 -> 直链下载 -> 调系统安装器 -->
        <activity
            android:name=".update.UpdateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          长按拍照搜题时，把目标文件交给系统相机写入。
          只暴露 cache/captures/，exported=false，且只授予单次 URI 权限。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
